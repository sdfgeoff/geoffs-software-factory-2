# The actual Commonroom server address, reachable from this worker machine.
# On the same Docker host, host.docker.internal requires that hostname in the
# server's ALLOWED_HOSTS; a LAN address normally works without extra setup.
COMMONROOM_SERVER=http://192.168.1.29:3000
COMMONROOM_WORKER_NAME=Workshop worker
# Startup fallback; the server UI controls the worker’s actual concurrency.
COMMONROOM_WORKER_CAPACITY=2
COMMONROOM_ENROLL_SECRET_FILE=./worker-enrollment.secret
