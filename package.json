{
  "name": "commonroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "share": "node scripts/share.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node test/browser.js",
    "test:board": "node test/board-browser.js",
    "test:attachments": "node test/chat-attachments-browser.js",
    "test:editor": "node test/editor-browser.js",
    "test:markdown": "node test/markdown-browser.js",
    "test:codex": "node scripts/smoke-codex.js",
    "test:notifications": "node test/notifications-browser.js",
    "test:search": "node test/search-browser.js",
    "worker": "node worker/index.js",
    "test:worker-container": "node test/worker-container.js",
    "test:worker-codex": "node scripts/smoke-worker.js",
    "test:workers": "node test/workers-browser.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "dompurify": "^3.4.17",
    "express": "^5.1.0",
    "marked": "^18.1.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  },
  "bin": {
    "commonroom-worker": "worker/index.js"
  }
}
